# ---------- Public (exposed to the browser) ----------
# Supabase project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- Server only (NEVER prefix with NEXT_PUBLIC_) ----------
# Service-role key. Used ONLY by /api/team/* route handlers (owner-only team management).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Optional ----------
# Public site origin used for WhatsApp product links during SSR (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only needed for `npm run db:*` (drizzle-kit)
DATABASE_URL=
